{
  "name": "automatizacion-cypress-grupo4",
  "version": "1.0.0",
  "description": "Pruebas de login, registro y perfil de Thiago Alonso",
  "main": "index.js",
  "scripts": {
    "setup:app": "node scripts/prepare-app.cjs",
    "patch:app": "node scripts/apply-app-patch.cjs",
    "start:app": "node scripts/start-app.cjs",
    "test": "cypress run --e2e --browser electron --config baseUrl=http://127.0.0.1:8000",
    "test:open": "cypress open --e2e --config baseUrl=http://127.0.0.1:8000",
    "test:login": "npm test -- --spec cypress/e2e/login.cy.js",
    "test:register": "npm test -- --spec cypress/e2e/register.cy.js",
    "test:profile": "npm test -- --spec cypress/e2e/user-profile.cy.js",
    "test:dashboard": "npm test -- --spec cypress/e2e/dashboard.cy.js",
    "cy:verify": "cypress verify",
    "cy:run": "cypress run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "cypress": "16.2.0",
    "dotenv": "17.2.3",
    "cross-spawn": "7.0.6"
  },
  "private": true,
  "engines": {
    "node": "^22.0.0 || ^24.0.0 || >=26.0.0"
  }
}
